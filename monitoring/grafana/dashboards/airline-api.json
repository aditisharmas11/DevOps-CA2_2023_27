        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "histogram_quantile(0.95, sum by (le) (rate(airline_api_http_request_duration_seconds_bucket{job=\"airline-api\",path=\"/predict\"}[5m])))",
          "instant": true,
          "legendFormat": ""
