            "mode": "absolute",
            "steps": [
              {
                "color": "#e03131",
                "value": null
              },
              {
                "color": "#2f9e44",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "auto",
